        },
        {
          "name": "public-ip-assignment",
          "type": "enum",
          "required": false,
          "location": "body",
          "description": "Configures public IP assignment of the Instances with:",
          "enum_values": [
            "inet4",
            "dual"
          ]
        },
        {
          "name": "labels",
          "type": "map",
          "required": false,
          "location": "body",
          "description": "Nodepool labels",
          "ref": "sks-nodepool-labels"
        },
        {
          "name": "taints",
          "type": "map",
          "required": false,
          "location": "body",
          "description": "Nodepool taints",
          "ref": "sks-nodepool-taints"
        },
        {
          "name": "security-groups",
          "type": "array",
          "required": false,
          "location": "body",
          "description": "Nodepool Security Groups",
          "item_type": "object"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "location": "body",
          "description": "Nodepool name, lowercase only"
        },
        {
          "name": "instance-type",
          "type": "object",
          "required": true,
          "location": "body",
          "description": "Nodepool instances type",
          "ref": "instance-type-ref"
        },
        {
          "name": "private-networks",
          "type": "array",
          "required": false,
          "location": "body",
          "description": "Nodepool Private Networks",
          "item_type": "object"
        },
        {
          "name": "size",
          "type": "integer",
          "required": true,
          "location": "body",
          "description": "Number of instances",
          "format": "int64"
        },
        {
          "name": "kubelet-image-gc",
          "type": "object",
          "required": false,
          "location": "body",
          "description": "Kubelet image GC options",
          "ref": "kubelet-image-gc"
        },
        {
          "name": "instance-prefix",
          "type": "string",
          "required": false,
          "location": "body",
          "description": "Prefix to apply to instances names (default: pool), lowercase only"
        },
        {
          "name": "deploy-target",
          "type": "object",
          "required": false,
          "location": "body",
          "description": "Nodepool Deploy Target",
          "ref": "deploy-target-ref"
        },
        {
          "name": "addons",
          "type": "array",
          "required": false,
          "location": "body",
          "description": "Nodepool addons",
          "item_type": "enum"
        },
        {
          "name": "disk-size",
          "type": "integer",
          "required": true,
          "location": "body",
          "description": "Nodepool instances disk size in GiB",
          "format": "int64"
        },
        {
          "name": "nvidia-mig-profiles",
          "type": "object",
          "required": false,
          "location": "body",
          "description": "Nvidia MIG Profiles",
          "ref": "nvidia-mig-profiles"
        }
      ],
      "response": {
        "schema": "operation",
        "is_operation": true
      }
    },
