    {
      "key": "sks.v2.SksCluster.create-sks-cluster",
      "id": "create-sks-cluster",
      "product": "sks",
      "version": "v2",
      "resource": "sks_cluster",
      "http_method": "POST",
      "path": "/sks-cluster",
      "summary": "Create an SKS cluster",
      "tags": [
        "cluster"
      ],
      "parameters": [
        {
          "name": "description",
          "type": "string",
          "required": false,
          "location": "body",
          "description": "Cluster description"
        },
        {
          "name": "labels",
          "type": "map",
          "required": false,
          "location": "body",
          "description": "Cluster Labels",
          "ref": "sks-cluster-labels"
        },
        {
          "name": "cni",
          "type": "enum",
          "required": false,
          "location": "body",
          "description": "Cluster CNI",
          "enum_values": [
            "calico",
            "cilium"
          ]
        },
        {
          "name": "auto-upgrade",
          "type": "boolean",
          "required": false,
          "location": "body",
          "description": "Enable auto upgrade of the control plane to the latest patch version available"
        },
        {
          "name": "networking",
          "type": "object",
          "required": false,
          "location": "body",
          "description": "Cluster networking configuration",
          "ref": "networking"
        },
        {
          "name": "oidc",
          "type": "object",
          "required": false,
          "location": "body",
          "description": "Cluster OpenID configmap",
          "ref": "sks-oidc"
        },
        {
          "name": "name",
          "type": "string",
          "required": true,
          "location": "body",
          "description": "Cluster name"
        },
        {
          "name": "create-default-security-group",
          "type": "boolean",
          "required": false,
          "location": "body",
          "description": "Creates an ad-hoc security group based on the choice of the selected CNI"
        },
        {
          "name": "enable-kube-proxy",
          "type": "boolean",
          "required": false,
          "location": "body",
          "description": "Indicates whether to deploy the Kubernetes network proxy. When unspecified, defaults to `true` unless Cilium CNI is selected"
        },
        {
          "name": "level",
          "type": "enum",
          "required": true,
          "location": "body",
          "description": "Cluster service level",
          "enum_values": [
            "starter",
            "pro"
          ]
        },
        {
          "name": "feature-gates",
          "type": "array",
          "required": false,
          "location": "body",
          "description": "A list of Kubernetes-only Alpha features to enable for API server component",
          "item_type": "string"
        },
        {
          "name": "addons",
          "type": "array",
          "required": false,
          "location": "body",
          "description": "Cluster addons",
          "item_type": "enum"
        },
        {
          "name": "audit",
          "type": "object",
          "required": false,
          "location": "body",
          "description": "Kubernetes Audit Log Configuration",
          "ref": "sks-audit-create"
        },
        {
          "name": "version",
          "type": "string",
          "required": true,
          "location": "body",
          "description": "Control plane Kubernetes version"
        }
      ],
      "response": {
        "schema": "operation",
        "is_operation": true
      }
    },
    {
