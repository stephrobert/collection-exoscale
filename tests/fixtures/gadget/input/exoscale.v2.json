            "type": "string"
          }
        }
      },
      "widget": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "operation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "state": {
            "type": "string",
            "enum": [
              "failure",
              "pending",
              "success",
              "timeout"
            ],
            "readOnly": true
          },
          "reason": {
